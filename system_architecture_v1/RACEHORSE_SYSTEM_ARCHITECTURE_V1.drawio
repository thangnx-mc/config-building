        </mxCell>
        <mxCell id="mod_2" value="&lt;b&gt;2. Horse &amp;amp; Pedigree Module&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:9.5px;color:#64748B;'&gt;Horse profile, 3-gen pedigree, ownership&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#CBD5E1;strokeWidth=1.2;fillColor=#F8FAFC;verticalAlign=top;align=left;spacingLeft=10;spacingTop=8;fontColor=#1E293B;" vertex="1" parent="1">
          <mxGeometry x="520" y="575" width="360" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="mod_3" value="&lt;b&gt;3. Training &amp;amp; Conflict Engine&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:9.5px;color:#64748B;'&gt;Hourly racetrack slot, conflict detection&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#CBD5E1;strokeWidth=1.2;fillColor=#F8FAFC;verticalAlign=top;align=left;spacingLeft=10;spacingTop=8;fontColor=#1E293B;" vertex="1" parent="1">
          <mxGeometry x="520" y="670" width="360" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="mod_4" value="&lt;b&gt;4. Racing &amp;amp; Competition Module&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:9.5px;color:#64748B;'&gt;Race events, entries, results, trials&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#CBD5E1;strokeWidth=1.2;fillColor=#F8FAFC;verticalAlign=top;align=left;spacingLeft=10;spacingTop=8;fontColor=#1E293B;" vertex="1" parent="1">
          <mxGeometry x="520" y="765" width="360" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="mod_5" value="&lt;b&gt;5. Clinical Care &amp;amp; Vet Module&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:9.5px;color:#64748B;'&gt;Exams, 21-zone injury map, training lock&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#CBD5E1;strokeWidth=1.2;fillColor=#F8FAFC;verticalAlign=top;align=left;spacingLeft=10;spacingTop=8;fontColor=#1E293B;" vertex="1" parent="1">
          <mxGeometry x="520" y="860" width="360" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="mod_6" value="&lt;b&gt;6. Stables &amp;amp; Facilities Module&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:9.5px;color:#64748B;'&gt;Barn map, stall grid, intake staging&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#CBD5E1;strokeWidth=1.2;fillColor=#F8FAFC;verticalAlign=top;align=left;spacingLeft=10;spacingTop=8;fontColor=#1E293B;" vertex="1" parent="1">
          <mxGeometry x="900" y="480" width="360" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="mod_7" value="&lt;b&gt;7. Care &amp;amp; Nutrition Module&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:9.5px;color:#64748B;'&gt;Checklists, feeding matrix, attendance&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#CBD5E1;strokeWidth=1.2;fillColor=#F8FAFC;verticalAlign=top;align=left;spacingLeft=10;spacingTop=8;fontColor=#1E293B;" vertex="1" parent="1">
          <mxGeometry x="900" y="575" width="360" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="mod_8" value="&lt;b&gt;8. Incidents &amp;amp; Inventory&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:9.5px;color:#64748B;'&gt;1-touch triage (&amp;lt;30s), stock replenishment&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#CBD5E1;strokeWidth=1.2;fillColor=#F8FAFC;verticalAlign=top;align=left;spacingLeft=10;spacingTop=8;fontColor=#1E293B;" vertex="1" parent="1">
