        <mxCell id="bk_proxy" value="&lt;b style='font-size:13px;color:#0F172A;'&gt;PayOS Webhook Proxy&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:11px;color:#64748B;'&gt;Node.js Micro-Proxy • Port :8099&lt;/span&gt;&lt;br/&gt;&lt;span style='font-size:10px;color:#334155;'&gt;Catches external PayOS webhooks &amp;amp; forwards&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#CBD5E1;strokeWidth=1.2;fillColor=#F8FAFC;verticalAlign=top;align=left;spacingLeft=10;spacingTop=8;fontColor=#1E293B;" vertex="1" parent="1">
