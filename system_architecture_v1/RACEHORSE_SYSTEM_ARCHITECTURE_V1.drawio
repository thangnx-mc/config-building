        <mxCell id="bk_server" value="&lt;b style='font-size:18px;color:#0F172A;'&gt;Spring Boot Application Server&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12.5px;color:#64748B;'&gt;Java 21 • Spring Boot 4.1.1 • Embedded Tomcat (:8080)&lt;/span&gt;&lt;br/&gt;&lt;span style='font-size:11px;color:#0284C7;font-weight:bold;'&gt;Architecture: Modular Monolith (com.racehorse.*) • Dockerized&lt;/span&gt;&lt;hr style='border:none;border-top:1px solid #CBD5E1;margin:8px 0;'/&gt;&lt;b style='font-size:11px;color:#1E293B;'&gt;Spring Security + OAuth2 Resource Server:&lt;/b&gt; &lt;span style='font-size:10.5px;color:#475569;'&gt;Bearer JWT Filter • RBAC Matrix (@PreAuthorize)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#334155;strokeWidth=1.8;fillColor=#FFFFFF;verticalAlign=top;align=left;spacingLeft=15;spacingTop=12;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="500" y="350" width="780" height="675" as="geometry"/>
        </mxCell>
        <mxCell id="mod_1" value="&lt;b&gt;1. Auth &amp;amp; RBAC Module&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:9.5px;color:#64748B;'&gt;JWT Auth, UserAccount, RolePermission&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#CBD5E1;strokeWidth=1.2;fillColor=#F8FAFC;verticalAlign=top;align=left;spacingLeft=10;spacingTop=8;fontColor=#1E293B;" vertex="1" parent="1">
