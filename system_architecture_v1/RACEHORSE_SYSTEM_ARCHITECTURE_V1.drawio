        </mxCell>
        <mxCell id="db_server" value="&lt;b style='font-size:18px;color:#0F172A;'&gt;Microsoft SQL Server&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12.5px;color:#64748B;'&gt;Relational Database • Port :1433 • Collation: Vietnamese_100_CI_AS_SC&lt;/span&gt;&lt;br/&gt;&lt;span style='font-size:11px;color:#0284C7;font-weight:bold;'&gt;racehorse_local / Azure SQL Database • Dockerized&lt;/span&gt;&lt;hr style='border:none;border-top:1px solid #CBD5E1;margin:8px 0;'/&gt;&lt;b style='font-size:11px;color:#1E293B;'&gt;48 T-SQL Schema &amp;amp; Migration Scripts (DATABASE/)&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:10px;color:#475569;'&gt;• Spring Data JPA &amp;amp; Hibernate ORM + JdbcTemplate&lt;br/&gt;• HikariCP Connection Pool (SET ARITHABORT ON)&lt;br/&gt;• Concurrency Locks (sp_getapplock for Stalls &amp;amp; Lanes)&lt;br/&gt;• ACID Transaction Management (@Transactional)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#334155;strokeWidth=1.8;fillColor=#FFFFFF;verticalAlign=top;align=left;spacingLeft=15;spacingTop=12;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="1330" y="255" width="500" height="340" as="geometry"/>
        </mxCell>
        <mxCell id="log_server" value="&lt;b style='font-size:18px;color:#0F172A;'&gt;Logging &amp;amp; Observability&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12.5px;color:#64748B;'&gt;Logback • SLF4J • Spring Boot Actuator • Database Audit&lt;/span&gt;&lt;hr style='border:none;border-top:1px solid #CBD5E1;margin:8px 0;'/&gt;&lt;b style='font-size:11px;color:#1E293B;'&gt;Spring Boot Actuator:&lt;/b&gt; &lt;span style='font-size:10px;color:#475569;'&gt;/actuator/health, /actuator/info&lt;/span&gt;&lt;br/&gt;&lt;b style='font-size:11px;color:#1E293B;'&gt;Application Logs:&lt;/b&gt; &lt;span style='font-size:10px;color:#475569;'&gt;logging.level.com.racehorse=INFO&lt;/span&gt;&lt;br/&gt;&lt;b style='font-size:11px;color:#1E293B;'&gt;Database Audit Trail:&lt;/b&gt; &lt;span style='font-size:10px;color:#475569;'&gt;dbo.audit_logs (roles, stalls, wallets)&lt;/span&gt;&lt;br/&gt;&lt;b style='font-size:11px;color:#1E293B;'&gt;Priority In-App Alerts:&lt;/b&gt; &lt;span style='font-size:10px;color:#475569;'&gt;dbo.notifications queue (&amp;lt;30s vet alert)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#334155;strokeWidth=1.8;fillColor=#FFFFFF;verticalAlign=top;align=left;spacingLeft=15;spacingTop=12;fontColor=#0F172A;" vertex="1" parent="1">
