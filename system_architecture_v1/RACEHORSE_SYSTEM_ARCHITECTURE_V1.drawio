        <mxCell id="mod_10" value="&lt;b&gt;10. Scheduled Automation&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:9.5px;color:#64748B;'&gt;DailyAutomationJob (cron 06:00), notif queue&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#CBD5E1;strokeWidth=1.2;fillColor=#F8FAFC;verticalAlign=top;align=left;spacingLeft=10;spacingTop=8;fontColor=#1E293B;" vertex="1" parent="1">
