        <!-- Title -->
        <mxCell id="title" value="&lt;b&gt;&lt;font style=&quot;font-size: 22px;&quot;&gt;RACEHORSE SYSTEM ARCHITECTURE DIAGRAM&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px; color: #64748b;&quot;&gt;Racehorse Training &amp;amp; Club Management System • Logical Software Architecture &amp;amp; Communication Baseline&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="610" y="20" width="700" height="50" as="geometry"/>
        </mxCell>

        <!-- REGION 4: THIRD-PARTY SERVICES -->
        <mxCell id="reg_third_party" value="THIRD-PARTY SERVICES" style="swimlane;whiteSpace=wrap;html=1;startSize=26;fillColor=#ffffff;strokeColor=#cbd5e1;fontStyle=1;fontSize=11;fontColor=#334155;rounded=1;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="650" y="85" width="1210" height="135" as="geometry"/>
        </mxCell>
        <mxCell id="card_cloudinary" value="&lt;b&gt;Cloudinary&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;color: #3448c5; font-size: 11px;&quot;&gt;Media Storage / Image Management&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #475569;&quot;&gt;• Cloud object &amp;amp; CDN media asset storage (cloudinary-http5)&lt;br&gt;• Horse photos, medical exams &amp;amp; care proof&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e2e8f0;align=left;spacingLeft=15;" vertex="1" parent="reg_third_party">
          <mxGeometry x="25" y="38" width="520" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="card_payos" value="&lt;b&gt;PayOS Gateway&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;font style=&quot;color: #582be8;&quot;&gt;Payment Gateway&lt;/font&gt;&amp;nbsp;&amp;nbsp;&lt;span style=&quot;background-color:#e11d48; color:#ffffff; padding:2px 6px; border-radius:3px; font-size:10px;&quot;&gt;VIETQR&lt;/span&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #475569;&quot;&gt;• Digital wallet checkout link creation &amp;amp; NAPAS247 VietQR generation&lt;br&gt;• Asynchronous payment notification webhooks with cryptographic checksum&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e2e8f0;align=left;spacingLeft=15;" vertex="1" parent="reg_third_party">
          <mxGeometry x="570" y="38" width="615" height="85" as="geometry"/>
        </mxCell>

        <!-- REGION 1: CLIENT APPLICATIONS -->
        <mxCell id="reg_client_apps" value="CLIENT APPLICATIONS" style="swimlane;whiteSpace=wrap;html=1;startSize=26;fillColor=#ffffff;strokeColor=#cbd5e1;fontStyle=1;fontSize=11;fontColor=#334155;rounded=1;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="60" y="85" width="420" height="955" as="geometry"/>
        </mxCell>
        <mxCell id="card_react_app" value="&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;Racehorse Web App&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;color: #0284c7; font-size: 11px;&quot;&gt;React 19 • Vite • React Router&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #334155;&quot;&gt;• Unified Single-Page Application (SPA)&lt;br&gt;• Centralized HTTP REST Client with Bearer JWT&lt;br&gt;• Dynamic role-based route guards &amp;amp; session state&lt;br&gt;• Recharts 3.8.0 performance analytics&lt;br&gt;• Three.js 3D racetrack simulator&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#38bdf8;align=left;spacingLeft=15;" vertex="1" parent="reg_client_apps">
          <mxGeometry x="20" y="38" width="380" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="lbl_roles" value="Role-Based User Workspaces (Inside Web App):" style="text;html=1;align=left;fontStyle=1;fontSize=11;fontColor=#1e293b;" vertex="1" parent="reg_client_apps">
          <mxGeometry x="20" y="200" width="350" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="role_manager" value="&lt;b&gt;Club Manager&lt;/b&gt; &lt;font style=&quot;color: #7e22ce;&quot;&gt;(CLUB_MANAGER)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 9.5px; color: #475569;&quot;&gt;• User account lifecycle &amp;amp; dynamic permission matrix&lt;br&gt;• Stable facility configuration &amp;amp; quarantine capacity rules&lt;br&gt;• Feed/bedding stock replenishment proposals &amp;amp; club audits&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e2e8f0;align=left;spacingLeft=12;" vertex="1" parent="reg_client_apps">
          <mxGeometry x="20" y="225" width="380" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="role_trainer" value="&lt;b&gt;Head Trainer&lt;/b&gt; &lt;font style=&quot;color: #b45309;&quot;&gt;(HEAD_TRAINER)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 9.5px; color: #475569;&quot;&gt;• Hourly racetrack slot reservations &amp;amp; schedule management&lt;br&gt;• Track lane conflict avoidance &amp;amp; horse readiness validation&lt;br&gt;• Conditioning plans, performance milestones &amp;amp; trial runs&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e2e8f0;align=left;spacingLeft=12;" vertex="1" parent="reg_client_apps">
          <mxGeometry x="20" y="350" width="380" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="role_vet" value="&lt;b&gt;Veterinarian&lt;/b&gt; &lt;font style=&quot;color: #047857;&quot;&gt;(VETERINARIAN)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 9.5px; color: #475569;&quot;&gt;• Routine health screening &amp;amp; vaccination histories&lt;br&gt;• Interactive 21-zone anatomical injury logging&lt;br&gt;• Training Lock enforcement (is_training_locked) &amp;amp; clearance&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e2e8f0;align=left;spacingLeft=12;" vertex="1" parent="reg_client_apps">
          <mxGeometry x="20" y="475" width="380" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="role_staff" value="&lt;b&gt;Stable Staff&lt;/b&gt; &lt;font style=&quot;color: #475569;&quot;&gt;(STABLE_STAFF)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 9.5px; color: #475569;&quot;&gt;• Morning/afternoon/evening shift care checklists&lt;br&gt;• Feeding plan execution &amp;amp; photo verification uploads&lt;br&gt;• 1-Touch abnormal condition reporting (&amp;lt;30s triage)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e2e8f0;align=left;spacingLeft=12;" vertex="1" parent="reg_client_apps">
          <mxGeometry x="20" y="600" width="380" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="role_owner" value="&lt;b&gt;Horse Owner&lt;/b&gt; &lt;font style=&quot;color: #b91c1c;&quot;&gt;(HORSE_OWNER)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 9.5px; color: #475569;&quot;&gt;• Horse profile, 3-generation pedigree &amp;amp; health records&lt;br&gt;• Daily automated care &amp;amp; training activity reports&lt;br&gt;• Digital wallet top-up via PayOS VietQR &amp;amp; boarding fees&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e2e8f0;align=left;spacingLeft=12;" vertex="1" parent="reg_client_apps">
          <mxGeometry x="20" y="725" width="380" height="110" as="geometry"/>
        </mxCell>

        <!-- REGION 2: BACKEND APPLICATION -->
        <mxCell id="reg_backend_app" value="BACKEND APPLICATION" style="swimlane;whiteSpace=wrap;html=1;startSize=26;fillColor=#ffffff;strokeColor=#cbd5e1;fontStyle=1;fontSize=11;fontColor=#334155;rounded=1;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="540" y="250" width="875" height="790" as="geometry"/>
        </mxCell>
        <mxCell id="card_spring_header" value="&lt;b&gt;&lt;font style=&quot;font-size: 16px;&quot;&gt;Spring Boot Backend Server&lt;/font&gt;&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;font style=&quot;color: #15803d;&quot;&gt;Java 21 • Spring Boot 4.1.1&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px; color: #0f172a;&quot;&gt;&lt;b&gt;Architecture: Modular Monolith (com.racehorse.*)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #475569;&quot;&gt;Single deployable archive hosting 10 cohesive modular domain packages with in-process eventing&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#86efac;align=left;spacingLeft=15;" vertex="1" parent="reg_backend_app">
          <mxGeometry x="20" y="38" width="835" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="card_spring_sec" value="&lt;b&gt;Spring Security:&lt;/b&gt; Stateless JWT Authentication &amp;amp; Dynamic Role-Based Access Control (@PreAuthorize)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#cbd5e1;align=center;" vertex="1" parent="reg_backend_app">
          <mxGeometry x="20" y="118" width="835" height="30" as="geometry"/>
        </mxCell>

        <!-- Domain Modules -->
        <mxCell id="mod1" value="&lt;b&gt;1. Auth &amp;amp; Admin&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 9.5px; color: #475569;&quot;&gt;User accounts, JWT auth &amp;amp; permissions&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e2e8f0;align=left;spacingLeft=10;" vertex="1" parent="reg_backend_app">
          <mxGeometry x="20" y="160" width="405" height="58" as="geometry"/>
        </mxCell>
        <mxCell id="mod6" value="&lt;b&gt;6. Stables &amp;amp; Facilities&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 9.5px; color: #475569;&quot;&gt;Barn stall grid &amp;amp; quarantine limits (max 4)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e2e8f0;align=left;spacingLeft=10;" vertex="1" parent="reg_backend_app">
          <mxGeometry x="450" y="160" width="405" height="58" as="geometry"/>
        </mxCell>
        <mxCell id="mod2" value="&lt;b&gt;2. Horse &amp;amp; Pedigree&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 9.5px; color: #475569;&quot;&gt;Horse profiles, RFID microchip &amp;amp; 3-gen pedigree&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e2e8f0;align=left;spacingLeft=10;" vertex="1" parent="reg_backend_app">
          <mxGeometry x="20" y="228" width="405" height="58" as="geometry"/>
        </mxCell>
        <mxCell id="mod7" value="&lt;b&gt;7. Care &amp;amp; Nutrition&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 9.5px; color: #475569;&quot;&gt;Shift checklists, feeding &amp;amp; ration templates&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e2e8f0;align=left;spacingLeft=10;" vertex="1" parent="reg_backend_app">
          <mxGeometry x="450" y="228" width="405" height="58" as="geometry"/>
        </mxCell>
        <mxCell id="mod3" value="&lt;b&gt;3. Training &amp;amp; Scheduling&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 9.5px; color: #475569;&quot;&gt;Hourly slot booking &amp;amp; track conflict algorithm&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e2e8f0;align=left;spacingLeft=10;" vertex="1" parent="reg_backend_app">
          <mxGeometry x="20" y="296" width="405" height="58" as="geometry"/>
        </mxCell>
        <mxCell id="mod8" value="&lt;b&gt;8. Incidents &amp;amp; Inventory&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 9.5px; color: #475569;&quot;&gt;1-Touch triage (&amp;lt;30s) &amp;amp; feed/bedding inventory&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e2e8f0;align=left;spacingLeft=10;" vertex="1" parent="reg_backend_app">
          <mxGeometry x="450" y="296" width="405" height="58" as="geometry"/>
        </mxCell>
        <mxCell id="mod4" value="&lt;b&gt;4. Racing &amp;amp; Events&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 9.5px; color: #475569;&quot;&gt;Race divisions, entry consent &amp;amp; trial runs&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e2e8f0;align=left;spacingLeft=10;" vertex="1" parent="reg_backend_app">
          <mxGeometry x="20" y="364" width="405" height="58" as="geometry"/>
        </mxCell>
        <mxCell id="mod9" value="&lt;b&gt;9. Digital Wallet &amp;amp; Billing&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 9.5px; color: #475569;&quot;&gt;Owner wallet ledger &amp;amp; PayOS payment checkout&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e2e8f0;align=left;spacingLeft=10;" vertex="1" parent="reg_backend_app">
          <mxGeometry x="450" y="364" width="405" height="58" as="geometry"/>
        </mxCell>
        <mxCell id="mod5" value="&lt;b&gt;5. Clinical Care &amp;amp; Health&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 9.5px; color: #475569;&quot;&gt;21-Zone injury mapping &amp;amp; training clearance lock&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e2e8f0;align=left;spacingLeft=10;" vertex="1" parent="reg_backend_app">
          <mxGeometry x="20" y="432" width="405" height="58" as="geometry"/>
        </mxCell>
        <mxCell id="mod10" value="&lt;b&gt;10. Automated Tasks &amp;amp; Alerts&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 9.5px; color: #475569;&quot;&gt;Daily cron automation (06:00 AM) &amp;amp; priority alerts&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e2e8f0;align=left;spacingLeft=10;" vertex="1" parent="reg_backend_app">
          <mxGeometry x="450" y="432" width="405" height="58" as="geometry"/>
        </mxCell>

        <!-- Internal capabilities -->
        <mxCell id="cap_obs" value="&lt;b&gt;Backend Logging &amp;amp; Health Diagnostics&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 9.5px; color: #475569;&quot;&gt;• SLF4J / Logback structured system logging&lt;br&gt;• Spring Boot Actuator (/actuator/health)&lt;br&gt;• In-process cron scheduling (@EnableScheduling)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#cbd5e1;align=left;spacingLeft=12;" vertex="1" parent="reg_backend_app">
          <mxGeometry x="20" y="505" width="405" height="250" as="geometry"/>
        </mxCell>
        <mxCell id="cap_integ" value="&lt;b&gt;Backend Integration Clients&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 9.5px; color: #475569;&quot;&gt;• Cloudinary media client (cloudinary-http5)&lt;br&gt;• PayOS payment client &amp;amp; webhook verification&lt;br&gt;• Spring Data JPA / Hibernate &amp;amp; HikariCP pool&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#cbd5e1;align=left;spacingLeft=12;" vertex="1" parent="reg_backend_app">
          <mxGeometry x="450" y="505" width="405" height="250" as="geometry"/>
        </mxCell>

        <!-- REGION 3: DATABASE & STORAGE -->
        <mxCell id="reg_db_storage" value="DATABASE &amp; STORAGE" style="swimlane;whiteSpace=wrap;html=1;startSize=26;fillColor=#ffffff;strokeColor=#cbd5e1;fontStyle=1;fontSize=11;fontColor=#334155;rounded=1;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="1465" y="250" width="395" height="790" as="geometry"/>
        </mxCell>
        <mxCell id="card_sql_server" value="&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;Microsoft SQL Server&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;color: #b91c1c; font-size: 11px;&quot;&gt;Relational Database Engine&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #475569;&quot;&gt;• Primary relational store for all club operations&lt;br&gt;• Centralized schema baseline with strict ACID guarantees&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff5f5;strokeColor=#fca5a5;align=left;spacingLeft=15;" vertex="1" parent="reg_db_storage">
          <mxGeometry x="20" y="38" width="355" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="card_db_model" value="&lt;b&gt;1. Relational Domain Entities&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 9.5px; color: #475569;&quot;&gt;• User accounts, roles &amp;amp; granular permissions&lt;br&gt;• Horse master records &amp;amp; 3-gen pedigree tree&lt;br&gt;• Stalls, facilities, track lanes &amp;amp; race events&lt;br&gt;• Clinical records, 21-zone injury logs &amp;amp; tasks&lt;br&gt;• Digital wallet balances &amp;amp; fee payment ledgers&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e2e8f0;align=left;spacingLeft=12;" vertex="1" parent="reg_db_storage">
          <mxGeometry x="20" y="145" width="355" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="card_db_lock" value="&lt;b&gt;2. Concurrency &amp;amp; Lock Management&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 9.5px; color: #475569;&quot;&gt;• sp_getapplock application locks&lt;br&gt;• Eliminates race conditions in track booking&lt;br&gt;• Strict quarantine stall limit enforcement (max 4)&lt;br&gt;• ACID compliance &amp;amp; foreign key constraints&lt;br&gt;• High-throughput pooled JDBC connections&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e2e8f0;align=left;spacingLeft=12;" vertex="1" parent="reg_db_storage">
          <mxGeometry x="20" y="315" width="355" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="card_db_audit" value="&lt;b&gt;3. Database Audit Trail (dbo.audit_logs)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 9.5px; color: #475569;&quot;&gt;• Captures pre- and post-modification state JSON&lt;br&gt;• Audits role permission updates &amp;amp; security changes&lt;br&gt;• Digital wallet balance &amp;amp; transaction traceability&lt;br&gt;• Medical clearance updates &amp;amp; training lock toggles&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e2e8f0;align=left;spacingLeft=12;" vertex="1" parent="reg_db_storage">
          <mxGeometry x="20" y="485" width="355" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="card_db_note" value="&lt;b&gt;Relational Integrity Guarantees:&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 9.5px; color: #475569;&quot;&gt;• Full referential integrity enforced via foreign keys&lt;br&gt;• Media stored externally in Cloudinary (URLs only)&lt;br&gt;• Optimistic locking (@Version) for concurrent edits&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#cbd5e1;align=left;spacingLeft=12;" vertex="1" parent="reg_db_storage">
          <mxGeometry x="20" y="655" width="355" height="100" as="geometry"/>
        </mxCell>

