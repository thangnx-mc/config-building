        <mxCell id="area_1" value="&amp;lt;div style=&amp;quot;padding: 26px 28px; box-sizing: border-box;&amp;quot;&amp;gt;
  &amp;lt;div style=&amp;quot;text-align: center; font-weight: bold; font-size: 18px; color: #0F172A; margin-bottom: 16px;&amp;quot;&amp;gt;Daily Tasks &amp;amp; Training&amp;lt;/div&amp;gt;
  &amp;lt;hr style=&amp;quot;border: none; border-top: 1px solid #E2E8F0; margin-bottom: 24px;&amp;quot; /&amp;gt;
  &amp;lt;div style=&amp;quot;font-size: 14.5px; line-height: 1.6; color: #1E293B;&amp;quot;&amp;gt;
    Review daily and assigned tasks.&lt;br/&gt;&lt;br/&gt;Check special or recovery instructions, if assigned.&lt;br/&gt;&lt;br/&gt;Prepare horses and equipment for training.&lt;br/&gt;&lt;br/&gt;Confirm readiness and mark assigned tasks as completed.
  &amp;lt;/div&amp;gt;
&amp;lt;/div&amp;gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#1E293B;strokeWidth=1.8;fillColor=#FFFFFF;verticalAlign=top;align=left;spacingTop=0;spacingLeft=0;spacingRight=0;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="82" y="380" width="400" height="370" as="geometry"/>
        </mxCell>
        <mxCell id="area_2" value="&amp;lt;div style=&amp;quot;padding: 26px 28px; box-sizing: border-box;&amp;quot;&amp;gt;
  &amp;lt;div style=&amp;quot;text-align: center; font-weight: bold; font-size: 18px; color: #0F172A; margin-bottom: 16px;&amp;quot;&amp;gt;Stable Management&amp;lt;/div&amp;gt;
  &amp;lt;hr style=&amp;quot;border: none; border-top: 1px solid #E2E8F0; margin-bottom: 24px;&amp;quot; /&amp;gt;
  &amp;lt;div style=&amp;quot;font-size: 14.5px; line-height: 1.6; color: #1E293B;&amp;quot;&amp;gt;
    Review stable layout and horse locations.&lt;br/&gt;&lt;br/&gt;Receive horse intake and check veterinary clearance.&lt;br/&gt;&lt;br/&gt;IF not cleared, hold intake and await veterinary decision.&lt;br/&gt;&lt;br/&gt;Check stall availability and safety before assigning or moving horses.
  &amp;lt;/div&amp;gt;
&amp;lt;/div&amp;gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#1E293B;strokeWidth=1.8;fillColor=#FFFFFF;verticalAlign=top;align=left;spacingTop=0;spacingLeft=0;spacingRight=0;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="534" y="380" width="400" height="370" as="geometry"/>
        </mxCell>
        <mxCell id="area_3" value="&amp;lt;div style=&amp;quot;padding: 26px 28px; box-sizing: border-box;&amp;quot;&amp;gt;
  &amp;lt;div style=&amp;quot;text-align: center; font-weight: bold; font-size: 18px; color: #0F172A; margin-bottom: 16px;&amp;quot;&amp;gt;Feeding Management&amp;lt;/div&amp;gt;
  &amp;lt;hr style=&amp;quot;border: none; border-top: 1px solid #E2E8F0; margin-bottom: 24px;&amp;quot; /&amp;gt;
  &amp;lt;div style=&amp;quot;font-size: 14.5px; line-height: 1.6; color: #1E293B;&amp;quot;&amp;gt;
    Review the approved daily feeding plan.&lt;br/&gt;&lt;br/&gt;Prepare the correct ration for each horse.&lt;br/&gt;&lt;br/&gt;IF a custom diet applies, follow the approved feeding instructions.&lt;br/&gt;&lt;br/&gt;Feed horses and record meal attendance.
  &amp;lt;/div&amp;gt;
&amp;lt;/div&amp;gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#1E293B;strokeWidth=1.8;fillColor=#FFFFFF;verticalAlign=top;align=left;spacingTop=0;spacingLeft=0;spacingRight=0;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="986" y="380" width="400" height="370" as="geometry"/>
        </mxCell>
        <mxCell id="area_4" value="&amp;lt;div style=&amp;quot;padding: 26px 28px; box-sizing: border-box;&amp;quot;&amp;gt;
  &amp;lt;div style=&amp;quot;text-align: center; font-weight: bold; font-size: 18px; color: #0F172A; margin-bottom: 16px;&amp;quot;&amp;gt;Incidents &amp;amp; Inventory&amp;lt;/div&amp;gt;
  &amp;lt;hr style=&amp;quot;border: none; border-top: 1px solid #E2E8F0; margin-bottom: 24px;&amp;quot; /&amp;gt;
  &amp;lt;div style=&amp;quot;font-size: 14.5px; line-height: 1.6; color: #1E293B;&amp;quot;&amp;gt;
    Report abnormal conditions and incidents.&lt;br/&gt;&lt;br/&gt;IF urgent, notify the relevant veterinarian and trainer.&lt;br/&gt;&lt;br/&gt;Track incident progress and update its resolution status.&lt;br/&gt;&lt;br/&gt;Check stock and request replenishment IF below the minimum level.
  &amp;lt;/div&amp;gt;
&amp;lt;/div&amp;gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#1E293B;strokeWidth=1.8;fillColor=#FFFFFF;verticalAlign=top;align=left;spacingTop=0;spacingLeft=0;spacingRight=0;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="1438" y="380" width="400" height="370" as="geometry"/>
        </mxCell>
